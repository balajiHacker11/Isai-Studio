{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated listener profile stored under /users/{userId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Display name from Google account" },
        "email": { "type": "string", "description": "Email address from Google account" },
        "photoUrl": { "type": "string", "description": "Optional avatar URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "LikedTrack": {
      "title": "LikedTrack",
      "description": "A favorited track from the Sai Abhyankkar catalog.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "trackNumber": { "type": "integer", "description": "Catalog track ID (1..110)" },
        "title": { "type": "string", "description": "Track title" },
        "album": { "type": "string", "description": "Album title" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when liked" }
      },
      "required": ["userId", "trackNumber", "title", "album", "createdAt"]
    },
    "UserPlaylist": {
      "title": "UserPlaylist",
      "description": "User-curated playlist referencing catalog track IDs.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "name": { "type": "string", "description": "Playlist name" },
        "description": { "type": "string", "description": "Playlist description" },
        "trackIds": { "type": "array", "description": "Ordered list of catalog track numbers (max 200)" },
        "coverKey": { "type": "string", "description": "Drawable cover key" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "name", "description", "trackIds", "coverKey", "createdAt", "updatedAt"]
    },
    "PlayHistoryEntry": {
      "title": "PlayHistoryEntry",
      "description": "Timestamped playback history event.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "trackNumber": { "type": "integer", "description": "Catalog track ID" },
        "title": { "type": "string", "description": "Track title" },
        "album": { "type": "string", "description": "Album title" },
        "playedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of play event" }
      },
      "required": ["userId", "trackNumber", "title", "album", "playedAt"]
    },
    "TrackLyrics": {
      "title": "TrackLyrics",
      "description": "Synced LRC lyrics attached to a track by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "trackNumber": { "type": "integer", "description": "Catalog track ID" },
        "lrcContent": { "type": "string", "description": "LRC formatted lyrics text" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "trackNumber", "lrcContent", "updatedAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Audio, theme, equalizer, and gesture preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "darkThemeEnabled": { "type": "boolean" },
        "dynamicTintEnabled": { "type": "boolean" },
        "accentKey": { "type": "string", "enum": ["coral", "cyan", "violet", "gold"] },
        "crossfadeSeconds": { "type": "integer" },
        "gaplessEnabled": { "type": "boolean" },
        "normalizeVolumeEnabled": { "type": "boolean" },
        "eqPreset": { "type": "string" },
        "eqBands": { "type": "array" },
        "privateSessionEnabled": { "type": "boolean" },
        "swipeMiniPlayerEnabled": { "type": "boolean" },
        "swipeArtworkEnabled": { "type": "boolean" },
        "swipeRowQueueEnabled": { "type": "boolean" },
        "swipeRowLikeEnabled": { "type": "boolean" },
        "doubleTapSeekEnabled": { "type": "boolean" },
        "doubleTapLikeEnabled": { "type": "boolean" },
        "hapticFeedbackEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "darkThemeEnabled",
        "dynamicTintEnabled",
        "accentKey",
        "crossfadeSeconds",
        "gaplessEnabled",
        "normalizeVolumeEnabled",
        "eqPreset",
        "eqBands",
        "privateSessionEnabled",
        "swipeMiniPlayerEnabled",
        "swipeArtworkEnabled",
        "swipeRowQueueEnabled",
        "swipeRowLikeEnabled",
        "doubleTapSeekEnabled",
        "doubleTapLikeEnabled",
        "hapticFeedbackEnabled",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile document."
    },
    "/users/{userId}/liked_tracks/{trackId}": {
      "schema": { "$ref": "#/entities/LikedTrack" },
      "description": "User's liked tracks subcollection."
    },
    "/users/{userId}/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/UserPlaylist" },
      "description": "User's custom playlists subcollection."
    },
    "/users/{userId}/play_history/{entryId}": {
      "schema": { "$ref": "#/entities/PlayHistoryEntry" },
      "description": "User's recently played history entries."
    },
    "/users/{userId}/lyrics/{trackDocId}": {
      "schema": { "$ref": "#/entities/TrackLyrics" },
      "description": "User's synced LRC lyrics per track."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserPreferences" },
      "description": "User's app, audio, and gesture settings."
    }
  }
}
