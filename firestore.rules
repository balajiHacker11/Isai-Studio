rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             data.email is string &&
             data.email.size() <= 160 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    function isValidLikedTrack(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.trackNumber is int &&
             data.trackNumber >= 1 &&
             data.trackNumber <= 1000 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.album is string &&
             data.album.size() >= 1 &&
             data.album.size() <= 160;
    }

    function isValidPlaylist(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 80 &&
             data.description is string &&
             data.description.size() <= 240 &&
             data.trackIds is list &&
             data.trackIds.size() <= 200 &&
             (data.trackIds.size() == 0 || data.trackIds[0] is int) &&
             data.coverKey is string &&
             data.coverKey.size() >= 1 &&
             data.coverKey.size() <= 40;
    }

    function isValidPlayHistory(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.trackNumber is int &&
             data.trackNumber >= 1 &&
             data.trackNumber <= 1000 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.album is string &&
             data.album.size() >= 1 &&
             data.album.size() <= 160;
    }

    function isValidTrackLyrics(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.trackNumber is int &&
             data.trackNumber >= 1 &&
             data.trackNumber <= 1000 &&
             data.lrcContent is string &&
             data.lrcContent.size() >= 1 &&
             data.lrcContent.size() <= 15000;
    }

    function isValidUserPreferences(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.darkThemeEnabled is bool &&
             data.dynamicTintEnabled is bool &&
             data.accentKey is string &&
             data.accentKey in ['coral', 'cyan', 'violet', 'gold'] &&
             data.crossfadeSeconds is int &&
             data.crossfadeSeconds >= 0 &&
             data.crossfadeSeconds <= 12 &&
             data.gaplessEnabled is bool &&
             data.normalizeVolumeEnabled is bool &&
             data.eqPreset is string &&
             data.eqPreset.size() >= 1 &&
             data.eqPreset.size() <= 40 &&
             data.eqBands is list &&
             data.eqBands.size() <= 10 &&
             (data.eqBands.size() == 0 || data.eqBands[0] is int) &&
             data.privateSessionEnabled is bool &&
             data.swipeMiniPlayerEnabled is bool &&
             data.swipeArtworkEnabled is bool &&
             data.swipeRowQueueEnabled is bool &&
             data.swipeRowLikeEnabled is bool &&
             data.doubleTapSeekEnabled is bool &&
             data.doubleTapLikeEnabled is bool &&
             data.hapticFeedbackEnabled is bool;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /liked_tracks/{trackId} {
        allow get: if isOwner(userId) && isValidId(trackId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(trackId) &&
                         incoming().keys().hasAll(['userId', 'trackNumber', 'title', 'album', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'trackNumber', 'title', 'album', 'createdAt']) &&
                         isValidLikedTrack(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(trackId);
      }

      match /playlists/{playlistId} {
        allow get: if isOwner(userId) && isValidId(playlistId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(playlistId) &&
                         incoming().keys().hasAll(['userId', 'name', 'description', 'trackIds', 'coverKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'description', 'trackIds', 'coverKey', 'createdAt', 'updatedAt']) &&
                         isValidPlaylist(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time;

        allow update: if isOwner(userId) &&
                         isValidId(playlistId) &&
                         isValidPlaylist(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'trackIds', 'coverKey', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(playlistId);
      }

      match /play_history/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(entryId) &&
                         incoming().keys().hasAll(['userId', 'trackNumber', 'title', 'album', 'playedAt']) &&
                         incoming().keys().hasOnly(['userId', 'trackNumber', 'title', 'album', 'playedAt']) &&
                         isValidPlayHistory(incoming()) &&
                         incoming().playedAt is timestamp &&
                         incoming().playedAt <= request.time;

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(entryId);
      }

      match /lyrics/{trackDocId} {
        allow get: if isOwner(userId) && isValidId(trackDocId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(trackDocId) &&
                         incoming().keys().hasAll(['userId', 'trackNumber', 'lrcContent', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'trackNumber', 'lrcContent', 'updatedAt']) &&
                         isValidTrackLyrics(incoming()) &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time;

        allow update: if isOwner(userId) &&
                         isValidId(trackDocId) &&
                         isValidTrackLyrics(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().trackNumber == existing().trackNumber &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['lrcContent', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(trackDocId);
      }

      match /preferences/{prefId} {
        allow get: if isOwner(userId) && isValidId(prefId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(prefId) &&
                         incoming().keys().hasAll([
                           'userId', 'darkThemeEnabled', 'dynamicTintEnabled', 'accentKey',
                           'crossfadeSeconds', 'gaplessEnabled', 'normalizeVolumeEnabled',
                           'eqPreset', 'eqBands', 'privateSessionEnabled',
                           'swipeMiniPlayerEnabled', 'swipeArtworkEnabled',
                           'swipeRowQueueEnabled', 'swipeRowLikeEnabled',
                           'doubleTapSeekEnabled', 'doubleTapLikeEnabled',
                           'hapticFeedbackEnabled', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'darkThemeEnabled', 'dynamicTintEnabled', 'accentKey',
                           'crossfadeSeconds', 'gaplessEnabled', 'normalizeVolumeEnabled',
                           'eqPreset', 'eqBands', 'privateSessionEnabled',
                           'swipeMiniPlayerEnabled', 'swipeArtworkEnabled',
                           'swipeRowQueueEnabled', 'swipeRowLikeEnabled',
                           'doubleTapSeekEnabled', 'doubleTapLikeEnabled',
                           'hapticFeedbackEnabled', 'updatedAt'
                         ]) &&
                         isValidUserPreferences(incoming()) &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time;

        allow update: if isOwner(userId) &&
                         isValidId(prefId) &&
                         isValidUserPreferences(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'darkThemeEnabled', 'dynamicTintEnabled', 'accentKey',
                           'crossfadeSeconds', 'gaplessEnabled', 'normalizeVolumeEnabled',
                           'eqPreset', 'eqBands', 'privateSessionEnabled',
                           'swipeMiniPlayerEnabled', 'swipeArtworkEnabled',
                           'swipeRowQueueEnabled', 'swipeRowLikeEnabled',
                           'doubleTapSeekEnabled', 'doubleTapLikeEnabled',
                           'hapticFeedbackEnabled', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(prefId);
      }
    }
  }
}
